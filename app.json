{
  "expo": {
    "name": "Wanderer's Ledger",
    "slug": "wander-ledger",
    "scheme": "wanderledger",
    "version": "0.4.7",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF9F2"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wanderledger.app",
      "buildNumber": "4",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "instagram",
          "instagram-stories",
          "whatsapp"
        ]
      }
    },
    "android": {
      "package": "com.wanderledger.app",
      "versionCode": 4,
      "adaptiveIcon": {
        "backgroundColor": "#FFF9F2",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": true,
            "appGroupId": "group.com.wanderledger.app",
            "activationRule": {
              "supportsText": true,
              "supportsImageWithMaxCount": 5,
              "supportsFileWithMaxCount": 1
            }
          },
          "android": {
            "enabled": true,
            "singleShareMimeTypes": ["image/*", "application/pdf", "text/plain"],
            "multipleShareMimeTypes": ["image/*"]
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Wanderer's Ledger to tag your travel memories with your current city.",
          "locationAlwaysPermission": false,
          "locationAlwaysAndWhenInUsePermission": false,
          "motionUsagePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Wanderer's Ledger to scan boarding passes, hotel confirmations, receipts, and capture travel memories.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Wanderer's Ledger to import travel memories and receipts from your photo library."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Wanderer's Ledger to save your Instagram postcards and collages to your photo gallery.",
          "savePhotosPermission": "Allow Wanderer's Ledger to save your Instagram postcards and collages to your photo gallery.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": ["photo"]
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
